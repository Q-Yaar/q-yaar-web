[
  {
    "id": "rail-path-case",
    "type": "line",
    "source": "transit-pmtiles",
    "source-layer": "subway",
    "filter": ["all", ["==", ["geometry-type"], "LineString"], ["has", "stroke"]],
    "minzoom": 8,
    "layout": {"line-join": "round", "line-cap": "round"},
    "paint": {
      "line-color": "#FFFFFF",
      "line-width": ["interpolate", ["linear"], ["zoom"], 12, 5, 16, 6, 22, 8],
      "line-opacity": 1
    }
  },
  {
    "id": "rail-path",
    "type": "line",
    "source": "transit-pmtiles",
    "source-layer": "subway",
    "filter": ["all", ["==", ["geometry-type"], "LineString"], ["has", "stroke"]],
    "minzoom": 8,
    "layout": {"line-join": "round", "line-cap": "round"},
    "paint": {
      "line-color": ["get", "stroke"],
      "line-width": ["interpolate", ["linear"], ["zoom"], 12, 3, 16, 4, 22, 6],
      "line-opacity": 0.8
    }
  },
  {
    "id": "transit-stops",
    "type": "circle",
    "source": "transit-pmtiles",
    "source-layer": "subway",
    "filter": ["all", ["==", ["geometry-type"], "Point"], ["has", "name"]],
    "paint": {
      "circle-radius": 4,
      "circle-color": ["coalesce", ["get", "station-color"], "#FF5722"]
    }
  },
  {
    "id": "transit-station-labels",
    "type": "symbol",
    "source": "transit-pmtiles",
    "source-layer": "subway",
    "filter": ["all", ["==", ["geometry-type"], "Point"], ["has", "name"]],
    "minzoom": 10,
    "layout": {
      "text-field": ["get", "name"],
      "text-font": ["Noto Sans Regular"],
      "text-size": ["interpolate", ["linear"], ["zoom"], 11, 10, 22, 16],
      "text-offset": [0, 0.5],
      "text-anchor": "top",
      "text-optional": true
    },
    "paint": {
      "text-color": "#000000",
      "text-halo-color": "#FFFFFF",
      "text-halo-width": 1,
      "text-opacity": ["interpolate", ["linear"], ["zoom"], 10, 0, 11, 1]
    }
  },
  {
    "id": "transit-stations-interchange",
    "type": "symbol",
    "source": "transit-pmtiles",
    "source-layer": "subway",
    "filter": ["all", ["==", ["geometry-type"], "Point"], ["==", ["get", "interchange"], true]],
    "minzoom": 9,
    "layout": {
      "icon-image": "metro-station",
      "icon-size": ["interpolate", ["linear"], ["zoom"], 10, 0.45, 22, 0.75],
      "icon-allow-overlap": true,
      "text-field": ["get", "name"],
      "text-font": ["Noto Sans Bold"],
      "text-size": ["interpolate", ["linear"], ["zoom"], 10, 10, 22, 16],
      "text-variable-anchor": ["left", "right", "top"],
      "text-radial-offset": 1.1,
      "text-optional": true
    },
    "paint": {
      "icon-color": "#000000",
      "text-color": "#000000",
      "text-halo-color": "#FFFFFF",
      "text-halo-width": 1,
      "icon-opacity": ["interpolate", ["linear"], ["zoom"], 9, 0, 10, 1],
      "text-opacity": ["interpolate", ["linear"], ["zoom"], 9, 0, 10, 1]
    }
  }
]
